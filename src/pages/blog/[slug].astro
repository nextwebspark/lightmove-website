---
import { getEntry, render } from 'astro:content';
import PostCard from '../../components/blog/PostCard.astro';
import Icon from '../../components/site/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, readingMinutes, tagSlug, type Post } from '../../lib/blog';
import { blogPosting, breadcrumbList } from '../../lib/seo/jsonld';
import { absoluteUrl, ogImagePathFor } from '../../lib/seo/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props {
  post: Post;
  all: Post[];
}

const { post, all } = Astro.props;
const { Content } = await render(post);
const author = await getEntry(post.data.author);
const related = [
  ...all.filter((p) => p.id !== post.id && p.data.tag === post.data.tag),
  ...all.filter((p) => p.id !== post.id && p.data.tag !== post.data.tag),
].slice(0, 3);
const path = `/blog/${post.id}`;
const shareUrl = absoluteUrl(path);
const bars = [90, 170, 250, 140, 70];
const jsonLd = [
  blogPosting({
    title: post.data.title,
    description: post.data.description,
    path,
    imagePath: ogImagePathFor(path),
    publishedAt: post.data.pubDate,
    updatedAt: post.data.updatedDate,
    authorName: author?.data.name ?? 'LightMove.ai',
    tags: [post.data.tag],
  }),
  breadcrumbList([
    { name: 'Blog', path: '/blog' },
    { name: post.data.tag, path: `/blog/tag/${tagSlug(post.data.tag)}` },
    { name: post.data.title, path },
  ]),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  draft={post.data.draft}
  article={{
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    tags: [post.data.tag],
  }}
  jsonLd={jsonLd}
>
  <div class="progress" aria-hidden="true"></div>
  <header class="container post-head">
    <a href="/blog" class="link-arrow in">
      ← All posts
    </a>
    <a href={`/blog/tag/${tagSlug(post.data.tag)}`} class="pill in d1">
      {post.data.tag}
    </a>
    <h1 class="in d1">{post.data.title}</h1>
    <p class="lead in d2">{post.data.description}</p>
    <div class="byline in d3">
      <span class="avatar">{author?.data.initials}</span>
      <span class="stack">
        <strong>{author?.data.name}</strong>
        <span class="muted">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time> ·{' '}
          {readingMinutes(post.body)} min read
        </span>
      </span>
    </div>
  </header>

  <div class="container art-wrap">
    <div class="art in d3" aria-hidden="true">
      {bars.map((h, i) => (
        <span
          class="wave-bar"
          style={`width:20px;height:${h}px;animation-delay:${i * 0.3}s;animation-duration:2.4s`}
        />
      ))}
    </div>
  </div>

  <article class="container post-body">
    <div class="prose">
      <Content />
    </div>

    <aside class="build-cta">
      <div class="stack" style="gap:4px;flex:1 1 280px">
        <strong class="cta-title">Rather we set it up?</strong>
        <span class="muted">Tell us about your calls and we'll build and test it for you.</span>
      </div>
      <a href="/#contact" class="btn btn-primary">
        Request a build
      </a>
    </aside>

    <div class="share">
      <span class="muted">Share this post</span>
      <span class="row-wrap" style="gap:8px">
        <a
          class="btn icon-btn"
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
          aria-label="Share on LinkedIn"
          rel="noopener"
          target="_blank"
        >
          <Icon name="linkedin" size={18} />
        </a>
        <a
          class="btn icon-btn"
          href={`mailto:?subject=${encodeURIComponent(post.data.title)}&body=${encodeURIComponent(shareUrl)}`}
          aria-label="Share by email"
        >
          <Icon name="link" size={18} />
        </a>
      </span>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section-band">
      <div class="container related">
        <h2 class="h-card">Keep reading</h2>
        <div class="row-wrap" style="gap:24px">
          {related.map((p) => (
            <PostCard post={p} compact />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 3px;
    background: var(--lm-green);
    transform: scaleX(0);
    transform-origin: left;
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      animation: grow linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes grow {
    to {
      transform: scaleX(1);
    }
  }
  .post-head {
    max-width: 880px;
    padding-block: 64px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
  }
  .post-head .pill {
    align-self: center;
    text-decoration: none;
  }
  h1 {
    font-family: var(--lm-font-display);
    font-weight: 600;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .post-head .lead {
    max-width: 620px;
    font-size: 20px;
    line-height: 32px;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
    font-size: 15px;
    line-height: 22px;
  }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--lm-panel);
    color: var(--lm-panel-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 14px;
  }
  .art-wrap {
    max-width: 1100px;
    padding-bottom: 56px;
  }
  .art {
    height: clamp(220px, 32vw, 400px);
    border-radius: 28px;
    background: var(--lm-wash);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .post-body {
    max-width: 768px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .build-cta {
    padding: 32px;
    border-radius: 22px;
    background: var(--lm-wash);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .cta-title {
    font-family: var(--lm-font-display);
    font-size: 22px;
    line-height: 28px;
    color: var(--lm-heading);
  }
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--lm-border);
  }
  .related {
    padding-block: 72px 88px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .related h2 {
    font-size: 28px;
    line-height: 34px;
  }
</style>
