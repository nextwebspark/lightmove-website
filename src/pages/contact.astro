---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/site/Icon.astro';
import { CONTACT_LIMITS, CONTACT_REASONS, HONEYPOT_FIELD } from '../lib/contact';
import { CONTACT_TOPICS, CONTACT_TOPIC_COPY } from '../lib/contactTopics';
import { staticPages } from '../lib/pages';
import { breadcrumbList } from '../lib/seo/jsonld';
import { gmailComposeUrl, mailtoUrl, outlookComposeUrl } from '../lib/mailCompose';
import { CONTACT_FORM, SITE } from '../lib/site';

const page = staticPages.contact;
const topics = [
  ...CONTACT_REASONS.filter((reason) => reason.id !== 'other').map((reason) => ({
    id: reason.id,
    label: reason.label,
    subject: reason.label,
  })),
  { id: 'other', label: 'Something else', subject: '' },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  jsonLd={[breadcrumbList([{ name: page.title, path: page.path }])]}
>
  <section class="container contact">
    <div class="contact-intro">
      <span class="eyebrow in">Contact</span>
      <h1 class="h-section in d1">Talk to the team</h1>
      <p class="lead in d2">
        Tell us what your callers need, or ask us anything about Lightmove. We'll reply by email.
      </p>
      <ul class="contact-ways in d3">
        <li>
          <Icon name="file" size={18} />
          <span>
            General questions: <a href={`mailto:${SITE.emails.hello}`}>{SITE.emails.hello}</a>
          </span>
        </li>
        <li>
          <Icon name="shield" size={18} />
          <span>
            Privacy and data requests:{' '}
            <a href={`mailto:${SITE.emails.privacy}`}>{SITE.emails.privacy}</a>
          </span>
        </li>
        <li>
          <Icon name="globe" size={18} />
          <span>
            {SITE.legal.entity}, {SITE.legal.registeredOffice}
          </span>
        </li>
      </ul>
    </div>

    <div class="contact-panel in d2">
      {CONTACT_FORM.enabled ? (
        <form
          class="contact-form"
          action={CONTACT_FORM.endpoint}
          method="post"
          data-contact-form
          aria-describedby="contact-privacy"
        >
          <h2 class="panel-title">Send us a message</h2>
          <p class="panel-muted">A person on our team reads every message and replies by email.</p>
          <p class="form-errors" role="alert" data-form-errors hidden />

          <fieldset class="field topics" aria-describedby="err-reason">
            <legend>What is this about?</legend>
            <div class="chips">
              {CONTACT_TOPICS.map((topic) => (
                <label class="chip">
                  <input
                    class="chip-input"
                    type="radio"
                    name="reason"
                    value={topic.id}
                    required
                    data-hint={topic.hint}
                    data-placeholder={topic.placeholder}
                    data-submit={topic.submit}
                  />
                  <span>{topic.chip}</span>
                </label>
              ))}
            </div>
            <p class="topic-hint" data-topic-hint hidden />
            <p class="field-error" id="err-reason" hidden />
          </fieldset>

          <div class="field" data-other-field>
            <label for="contact-reason-other">If you chose Other, what is it about?</label>
            <input
              id="contact-reason-other"
              name="reasonOther"
              type="text"
              maxlength={CONTACT_LIMITS.reasonOther}
              aria-describedby="err-reasonOther"
            />
            <p class="field-error" id="err-reasonOther" hidden />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="contact-name">Your name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength={CONTACT_LIMITS.name}
                aria-describedby="err-name"
              />
              <p class="field-error" id="err-name" hidden />
            </div>
            <div class="field">
              <label for="contact-email">Work email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                placeholder="you@company.ie"
                required
                maxlength={CONTACT_LIMITS.email}
                aria-describedby="err-email"
              />
              <p class="field-error" id="err-email" hidden />
            </div>
          </div>

          <div class="field">
            <label for="contact-company">
              Company <span class="optional">(optional)</span>
            </label>
            <input
              id="contact-company"
              name="company"
              type="text"
              autocomplete="organization"
              maxlength={CONTACT_LIMITS.company}
              aria-describedby="err-company"
            />
            <p class="field-error" id="err-company" hidden />
          </div>

          <div class="field">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              minlength={CONTACT_LIMITS.messageMin}
              maxlength={CONTACT_LIMITS.message}
              aria-describedby="err-message"
            />
            <p class="field-error" id="err-message" hidden />
          </div>

          <div class="hp" aria-hidden="true">
            <label for="contact-website">Leave this empty</label>
            <input
              id="contact-website"
              name={HONEYPOT_FIELD}
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <p class="privacy-note" id="contact-privacy">
            We use these details only to reply to you, and keep your message for [ENQUIRY RETENTION
            PERIOD]. We won't add you to a mailing list.{' '}
            <a href="/privacy#2-what-we-collect">How we handle your data</a>
          </p>

          <button type="submit" class="btn btn-panel btn-lg" data-contact-submit>
            {CONTACT_TOPIC_COPY.other.submit}
          </button>
          <p class="form-status" role="status" aria-live="polite" data-form-status />
        </form>
      ) : (
        <div class="contact-form">
          <h2 class="panel-title">Email us</h2>
          <p class="panel-muted">
            Pick a topic and your email app opens with the subject filled in. Use Gmail or Outlook
            in your browser? You'll get a link for that too.
          </p>
          <ul class="mail-topics">
            {topics.map((topic) => (
              <li>
                <a
                  href={mailtoUrl(SITE.emails.hello, topic.subject || undefined)}
                  data-mail-topic={topic.id}
                  data-subject={topic.subject}
                >
                  {topic.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="mail-help" data-mail-help hidden>
            <p class="mail-help-text" role="status" aria-live="polite" data-mail-help-text>
              Write to {SITE.emails.hello}.
            </p>
            <div class="mail-help-actions">
              <a
                class="mail-help-btn"
                href={gmailComposeUrl(SITE.emails.hello)}
                target="_blank"
                rel="noopener"
                data-mail-gmail
              >
                Open in Gmail
              </a>
              <a
                class="mail-help-btn"
                href={outlookComposeUrl(SITE.emails.hello)}
                target="_blank"
                rel="noopener"
                data-mail-outlook
              >
                Open in Outlook
              </a>
              <button
                type="button"
                class="mail-help-btn"
                data-mail-copy
                data-address={SITE.emails.hello}
              >
                Copy address
              </button>
            </div>
          </div>
        </div>
      )}
      <div class="contact-done" tabindex="-1" data-contact-done hidden>
        <h2 class="panel-title">Thanks, your message is on its way</h2>
        <p class="panel-muted">
          It has reached our team at {SITE.emails.hello}, and we'll reply to the email address you
          gave.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { validateContact, type ContactField } from '../lib/contact';
  import { topicFromSearch } from '../lib/contactTopics';
  import { gmailComposeUrl, outlookComposeUrl } from '../lib/mailCompose';

  // Without the form: a topic opens the visitor's email app (mailto), and we
  // also show Gmail, Outlook and copy options, because a mailto click does
  // nothing at all when no email app is set up.
  const help = document.querySelector<HTMLElement>('[data-mail-help]');
  if (help) {
    const text = help.querySelector<HTMLElement>('[data-mail-help-text]');
    const gmail = help.querySelector<HTMLAnchorElement>('[data-mail-gmail]');
    const outlook = help.querySelector<HTMLAnchorElement>('[data-mail-outlook]');
    const copy = help.querySelector<HTMLButtonElement>('[data-mail-copy]');
    const address = copy?.dataset.address ?? 'hello@lightmove.ai';
    const topics = document.querySelectorAll<HTMLAnchorElement>('[data-mail-topic]');

    const showFor = (topic: HTMLAnchorElement) => {
      const subject = topic.dataset.subject || undefined;
      topics.forEach((t) => t.toggleAttribute('aria-current', t === topic));
      if (text) {
        text.textContent = subject
          ? `If your email app didn't open, write to ${address} with the subject "${subject}", or use one of these:`
          : `If your email app didn't open, write to ${address}, or use one of these:`;
      }
      if (gmail) gmail.href = gmailComposeUrl(address, subject);
      if (outlook) outlook.href = outlookComposeUrl(address, subject);
      if (copy) copy.textContent = 'Copy address';
      help.hidden = false;
    };

    topics.forEach((topic) =>
      topic.addEventListener('click', () => {
        showFor(topic);
        // On a phone the options sit below the list, out of sight.
        help.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }),
    );

    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(address);
        copy.textContent = 'Copied';
      } catch {
        copy.textContent = address;
      }
    });

    // Links such as /contact?reason=pricing show that topic's options straight away.
    const preset = new URLSearchParams(window.location.search).get('reason');
    const presetTopic = [...topics].find((t) => t.dataset.mailTopic === preset);
    if (presetTopic) showFor(presetTopic);
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const done = document.querySelector<HTMLElement>('[data-contact-done]');
    const summary = form.querySelector<HTMLElement>('[data-form-errors]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const topics = [...form.querySelectorAll<HTMLInputElement>('input[name="reason"]')];
    const hint = form.querySelector<HTMLElement>('[data-topic-hint]');
    const messageBox = form.querySelector<HTMLTextAreaElement>('[name="message"]');
    const chosen = () => topics.find((t) => t.checked) ?? null;
    const otherField = form.querySelector<HTMLElement>('[data-other-field]');
    const otherLabel = otherField?.querySelector('label');
    const fields: ContactField[] = ['reason', 'reasonOther', 'name', 'email', 'company', 'message'];

    // With JavaScript we check fields ourselves, so errors read the same in every browser.
    form.noValidate = true;
    if (otherLabel) otherLabel.textContent = 'What is it about?';

    const syncOther = () => {
      if (!otherField) return;
      const isOther = chosen()?.value === 'other';
      otherField.hidden = !isOther;
      otherField.querySelector('input')?.toggleAttribute('required', isOther);
    };

    // The chosen topic shapes the form: its hint, an example message and the button label.
    const syncTopic = () => {
      const topic = chosen();
      syncOther();
      if (hint) {
        hint.textContent = topic?.dataset.hint ?? '';
        hint.hidden = !topic;
      }
      if (messageBox) messageBox.placeholder = topic?.dataset.placeholder ?? '';
      if (submit && topic?.dataset.submit) submit.textContent = topic.dataset.submit;
    };

    // Links such as /contact?reason=pricing (or ?kind=pricing) choose the topic.
    const preset = topicFromSearch(window.location.search);
    const presetInput = topics.find((t) => t.value === preset);
    if (presetInput) presetInput.checked = true;
    syncTopic();
    topics.forEach((t) =>
      t.addEventListener('change', () => {
        syncTopic();
        history.replaceState(null, '', `/contact?reason=${t.value}`);
      }),
    );

    const showErrors = (errors: Partial<Record<ContactField, string>>) => {
      let first: HTMLElement | null = null;
      for (const name of fields) {
        const control = form.querySelector<HTMLElement>(`[name="${name}"]`);
        const message = form.querySelector<HTMLElement>(`#err-${name}`);
        const error = errors[name];
        control?.setAttribute('aria-invalid', error ? 'true' : 'false');
        if (message) {
          message.textContent = error ?? '';
          message.hidden = !error;
        }
        if (error && !first) first = control;
      }
      const count = Object.keys(errors).length;
      if (summary) {
        summary.hidden = count === 0;
        summary.textContent =
          count === 1 ? 'One field needs attention.' : `${count} fields need attention.`;
      }
      first?.focus();
    };

    const fail = (message: string) => {
      if (!status) return;
      status.textContent = '';
      const text = document.createElement('span');
      text.textContent = `${message} You can also email `;
      const link = document.createElement('a');
      link.href = 'mailto:hello@lightmove.ai';
      link.textContent = 'hello@lightmove.ai';
      status.append(text, link, '.');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const checked = validateContact(data);
      if (!checked.ok) {
        showErrors(checked.errors);
        return;
      }
      showErrors({});
      if (submit) submit.disabled = true;
      if (status) status.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const result = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
          fields?: Partial<Record<ContactField, string>>;
        };
        if (response.ok && result.ok) {
          form.hidden = true;
          if (done) {
            done.hidden = false;
            done.focus();
          }
          return;
        }
        if (result.fields) showErrors(result.fields);
        fail(result.message ?? "Your message wasn't sent.");
      } catch {
        fail("We couldn't reach our server, so your message wasn't sent.");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

<style>
  .contact {
    padding-block: 64px var(--lm-section-y);
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }
  .contact-intro {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 480px;
  }
  .contact-ways {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 15px;
    line-height: 22px;
  }
  .contact-ways li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .contact-ways :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--lm-brand);
  }
  .contact-panel {
    flex: 1 1 460px;
    min-width: 0;
    background: var(--lm-panel);
    color: var(--lm-panel-text);
    border: 1px solid var(--lm-border);
    border-radius: 32px;
    padding: clamp(24px, 4vw, 48px);
  }
  .contact-form,
  .contact-done {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .contact-form[hidden],
  .contact-done[hidden],
  .field[hidden] {
    display: none;
  }
  .panel-title {
    color: var(--lm-panel-text);
    font-family: var(--lm-font-display);
    font-weight: 600;
    font-size: 26px;
    line-height: 32px;
    letter-spacing: -0.02em;
  }
  .panel-muted,
  .privacy-note {
    color: var(--lm-panel-muted);
    font-size: 15px;
    line-height: 22px;
  }
  .contact-panel a {
    color: var(--lm-panel-accent);
  }
  .field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .field-row .field {
    flex: 1 1 200px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  label {
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--lm-panel-text);
  }
  .optional {
    font-weight: 400;
    color: var(--lm-panel-muted);
  }
  input:not(.chip-input),
  select,
  textarea {
    width: 100%;
    min-height: 54px;
    box-sizing: border-box;
    padding: 0 16px;
    border-radius: 14px;
    border: 1px solid var(--lm-panel-line);
    background: var(--lm-panel-field);
    color: var(--lm-panel-text);
    font: inherit;
    font-size: 16px;
  }
  textarea {
    padding: 14px 16px;
    resize: vertical;
    line-height: 24px;
  }
  input::placeholder {
    color: var(--lm-panel-muted);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid rgba(61, 220, 151, 0.55);
    outline-offset: 1px;
    border-color: var(--lm-panel-accent);
  }
  [aria-invalid='true'] {
    border-color: var(--lm-spark);
  }
  .field-error,
  .form-errors {
    color: #ffb27f;
    font-size: 14px;
    line-height: 20px;
  }
  .form-errors {
    font-weight: 600;
  }
  .form-status {
    color: var(--lm-panel-muted);
    font-size: 15px;
    line-height: 22px;
  }
  .form-status:empty {
    display: none;
  }
  .contact-form .btn {
    align-self: flex-start;
  }
  .contact-form .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .topics {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .topics legend {
    margin-bottom: 10px;
    padding: 0;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--lm-panel-text);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--lm-panel-line);
    background: var(--lm-panel-field);
    color: var(--lm-panel-text);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--lm-panel-accent);
  }
  .chips .chip-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .chip:has(.chip-input:checked) {
    border-color: var(--lm-panel-accent);
    background: var(--lm-panel-accent);
    color: var(--lm-panel);
  }
  .chip:has(.chip-input:focus-visible) {
    outline: 3px solid rgba(61, 220, 151, 0.55);
    outline-offset: 2px;
  }
  .topic-hint {
    margin: 4px 0 0;
    color: var(--lm-panel-muted);
    font-size: 15px;
    line-height: 22px;
  }
  .topic-hint[hidden] {
    display: none;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .mail-topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mail-topics a {
    display: flex;
    align-items: center;
    min-height: 54px;
    padding: 0 18px;
    border-radius: 14px;
    border: 1px solid var(--lm-panel-line);
    background: var(--lm-panel-field);
    color: var(--lm-panel-text);
    font-weight: 600;
    text-decoration: none;
  }
  .mail-topics a:hover,
  .mail-topics a[aria-current] {
    border-color: var(--lm-panel-accent);
  }
  .mail-help {
    margin-top: 16px;
    padding: 16px 18px;
    border-radius: 14px;
    border: 1px solid var(--lm-panel-accent);
    background: var(--lm-panel-field);
  }
  .mail-help[hidden] {
    display: none;
  }
  .mail-help-text {
    margin: 0 0 12px;
    color: var(--lm-panel-text);
    font-size: 15px;
    line-height: 22px;
  }
  .mail-help-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .mail-help .mail-help-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 10px;
    border: 1px solid var(--lm-panel-line);
    background: transparent;
    color: var(--lm-panel-text);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .mail-help .mail-help-btn:hover {
    border-color: var(--lm-panel-accent);
  }
</style>
