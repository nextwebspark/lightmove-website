---
// Where /api/contact sends visitors whose browser posted the form without JavaScript.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { staticPages } from '../../lib/pages';
import { SITE } from '../../lib/site';

const page = staticPages.contactSent;
---

<BaseLayout title={page.title} description={page.description} ogTitle={page.ogTitle} noindex>
  <section class="container sent">
    <span class="eyebrow">Contact</span>
    <h1 class="h-section">Thanks, your message is on its way</h1>
    <p class="lead">
      It has reached our team at {SITE.emails.hello}, and we'll reply to the email address you gave.
    </p>
    <a href="/" class="btn btn-primary btn-lg">
      Back to the home page
    </a>
  </section>
</BaseLayout>

<style>
  .sent {
    padding-block: 96px 128px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .sent .lead {
    max-width: 560px;
  }
</style>
