---
import { SITE, contactHref } from '../../lib/site';
const bars = [120, 220, 300, 180, 90];
---

<section class="container cta-wrap" id="contact">
  <div class="cta reveal">
    <div class="glow" style="width:520px;height:520px;right:-120px;top:-160px;background:rgba(61,220,151,.28);opacity:1" aria-hidden="true"></div>
    <div class="cta-bars" aria-hidden="true">
      {bars.map((h, i) => <span class="wave-bar" style={`width:22px;height:${h}px;animation-delay:${i * 0.3}s`} />)}
    </div>
    <div class="cta-copy">
      <h2>Stop missing calls.<br /><span>Start this week.</span></h2>
      <p>Tell us what your callers need. We'll reply within one working day with a plan and a quote.</p>
    </div>
    <div class="cta-actions">
      <a href={contactHref('Build me a voice agent')} class="btn btn-panel btn-lg">Request a build</a>
      <a href={contactHref('VoIP partnership')} class="btn btn-lg ghost">VoIP partnerships</a>
      <p class="small">Or email <a href={`mailto:${SITE.emails.hello}`}>{SITE.emails.hello}</a></p>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-bottom: 112px;
  }
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--lm-panel);
    color: var(--lm-panel-text);
    border: 1px solid var(--lm-border);
    border-radius: 32px;
    padding: clamp(32px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .cta-bars {
    position: absolute;
    right: 40px;
    bottom: -20px;
    display: flex;
    align-items: flex-end;
    gap: 14px;
    opacity: 0.14;
  }
  .cta-bars :global(.wave-bar) {
    background: var(--lm-panel-accent);
  }
  .cta-copy,
  .cta-actions {
    position: relative;
  }
  .cta-copy {
    flex: 1 1 440px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h2 {
    color: var(--lm-panel-text);
    font-family: var(--lm-font-display);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  h2 span {
    color: var(--lm-panel-accent);
  }
  .cta-copy p {
    color: var(--lm-panel-muted);
    font-size: 18px;
    line-height: 28px;
    max-width: 480px;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .ghost,
  .ghost:hover {
    border: 1.5px solid var(--lm-panel-line);
    color: var(--lm-panel-text);
  }
  .small {
    flex-basis: 100%;
    font-size: 14px;
    color: var(--lm-panel-muted);
  }
  .small a {
    color: var(--lm-panel-accent);
  }
</style>
