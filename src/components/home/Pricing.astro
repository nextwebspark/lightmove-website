---
import { APP } from '../../lib/site';
import Icon from '../site/Icon.astro';

// Prices match the app's billing (failte-ai api/services/billing/pricing.py) and were signed off by
// the owner on 2026-11-05. Change both together. Every feature line is something the app does today:
// "10 calls at once" is DEFAULT_ORG_CONCURRENCY_LIMIT; Enterprise rates, call limits and credit
// limits are per-account settings (billing_accounts.price_per_minute_eur / credit_limit_eur and the
// organisation's CONCURRENT_CALL_LIMIT).
const plans = [
  {
    audience: 'To try it',
    name: 'Try',
    summary: '€5 of free credit, about 40 minutes of calls.',
    price: '€0',
    unit: '',
    note: 'No monthly fee. No commitment.',
    cta: { label: 'Start free', href: APP.signUpUrl },
    features: ['All agent templates', 'Test calls in your browser', 'Transcripts and recordings'],
    tone: 'try',
    featured: false,
  },
  {
    audience: 'For businesses',
    name: 'Pay as you go',
    summary: 'Prepaid credit. Top up from €20.',
    price: '€0.12',
    unit: '/min',
    note: '€0 monthly fee. Excludes VAT.',
    cta: { label: 'Get started', href: APP.signUpUrl },
    features: [
      'Charged by the second',
      'Your own phone number or SIP',
      'Up to 10 calls at once',
      'Calendar booking and transfers',
      'Recordings and call summaries',
    ],
    tone: 'payg',
    featured: true,
  },
  {
    audience: 'For organisations',
    name: 'Enterprise',
    summary: 'Built and run with our team, at your volume.',
    price: 'Custom',
    unit: '',
    note: 'Contracted to your volume.',
    cta: { label: 'Talk to our team', href: '/contact?reason=pricing' },
    features: [
      'Volume per-minute rate',
      'More calls at once',
      'Agents and integrations built for you',
      'Pay on invoice',
    ],
    tone: 'enterprise',
    featured: false,
  },
];
---

<section class="section container" id="pricing">
  <div class="section-head center reveal">
    <span class="eyebrow">Pricing</span>
    <h2 class="h-section">Clear pricing on every call</h2>
    <p class="lead">One rate per minute. No token charges and no surprise bills.</p>
  </div>
  <div class="plans">
    {plans.map((p) => (
      <article class:list={['plan reveal', `tone-${p.tone}`, { featured: p.featured }]}>
        <header class="plan-head">
          {p.featured && <span class="badge">Most popular</span>}
          <span class="audience">{p.audience}</span>
          <h3 class="plan-name">{p.name}</h3>
          <p class="summary">{p.summary}</p>
        </header>
        <div class="plan-body">
          <p class="price">
            {p.price}
            {p.unit && <span class="unit">{p.unit}</span>}
          </p>
          <p class="note">{p.note}</p>
          <a
            href={p.cta.href}
            class:list={['btn', p.tone === 'enterprise' ? 'btn-secondary' : 'btn-primary']}
          >
            {p.cta.label}
          </a>
          <ul>
            {p.features.map((f) => (
              <li>
                <Icon name="check" size={18} strokeWidth={2} />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .plans {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: stretch;
  }
  .plan {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--lm-surface);
    border: 1px solid var(--lm-border);
    border-radius: 16px;
  }
  /* The middle plan is the one we recommend: a solid brand header, a
     stronger border and a slight lift, so it reads as already selected. */
  .plan.featured {
    position: relative;
    border: 2px solid var(--lm-brand);
    box-shadow:
      0 18px 40px -18px color-mix(in srgb, var(--lm-brand) 55%, transparent),
      var(--lm-shadow);
  }
  @media (min-width: 960px) {
    .plan.featured {
      /* `translate`, not `transform`: the scroll-in animation owns transform. */
      translate: 0 -10px;
    }
  }
  .plan.featured .plan-head {
    background: var(--lm-brand);
    border-bottom-color: var(--lm-brand);
  }
  .plan.featured .audience,
  .plan.featured .plan-name,
  .plan.featured .summary {
    color: var(--lm-on-brand);
  }
  .plan.featured .audience,
  .plan.featured .summary {
    opacity: 0.88;
  }
  .badge {
    position: absolute;
    top: 20px;
    right: 22px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--lm-on-brand);
    color: var(--lm-brand);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .plan-head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 140px;
    padding: 24px 28px;
    border-bottom: 1px solid var(--lm-border);
  }
  .tone-try .plan-head {
    background: var(--lm-surface-2);
  }
  .tone-payg .plan-head {
    background: var(--lm-wash);
  }
  .tone-enterprise .plan-head {
    background: var(--lm-warn-bg);
  }
  .audience {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lm-muted);
  }
  .plan-name {
    font-family: var(--lm-font-display);
    font-size: 24px;
    line-height: 30px;
    font-weight: 600;
    color: var(--lm-heading);
  }
  .summary {
    font-size: 15px;
    line-height: 22px;
    color: var(--lm-muted);
  }
  .plan-body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 2px;
    font-family: var(--lm-font-display);
    font-weight: 600;
    font-size: 44px;
    line-height: 52px;
    letter-spacing: -0.03em;
    color: var(--lm-heading);
  }
  .unit {
    margin-left: 4px;
    line-height: 1;
    font-family: var(--lm-font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--lm-muted);
    letter-spacing: 0;
  }
  .note {
    min-height: 20px;
    font-size: 14px;
    line-height: 20px;
    color: var(--lm-muted);
  }
  .btn {
    min-height: 44px;
    margin-block: 20px 8px;
  }
  ul {
    margin: 0;
    padding: 20px 0 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--lm-border);
    font-size: 15px;
  }
  li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  li :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--lm-brand);
  }
</style>
