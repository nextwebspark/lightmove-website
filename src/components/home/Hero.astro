---
import Icon from '../site/Icon.astro';
import VoiceDemo from './VoiceDemo.astro';
import { APP } from '../../lib/site';

const promises = ['No card to try', 'Keep your phone number', 'Pay only for minutes used'];
---

<section class="hero">
  <div class="hero-dots" aria-hidden="true"></div>
  <div
    class="glow"
    style="width:560px;height:560px;right:6%;top:60px;background:rgba(61,220,151,.24)"
    aria-hidden="true"
  ></div>
  <div
    class="glow"
    style="width:340px;height:340px;left:-100px;top:-80px;background:rgba(255,136,62,.12);animation-delay:-7s"
    aria-hidden="true"
  ></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="pill pill-outline in">
        <span class="live-dot"></span>Voice AI agents, made in Limerick
      </span>
      <h1 class="display in d1">
        Every call answered.
        <br />
        <span class="accent">Day or night.</span>
      </h1>
      <p class="lead in d2">
        LightMove.ai gives your business a voice agent that picks up the phone, books appointments
        and answers questions in a natural voice, then hands over to your team when it matters.
      </p>
      <div class="hero-ctas in d3">
        <a href={APP.signUpUrl} class="btn btn-primary btn-lg">
          Build your agent free <Icon name="arrow-right" size={18} strokeWidth={2} />
        </a>
        <a href="/#contact" class="btn btn-secondary btn-lg">
          Have us build it
        </a>
      </div>
      <ul class="hero-promises in d4">
        {promises.map((p) => (
          <li>
            <Icon name="check" size={18} strokeWidth={2} />
            {p}
          </li>
        ))}
      </ul>
    </div>
    <VoiceDemo />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--lm-border) 1.2px, transparent 1.2px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(ellipse at 72% 38%, #000 15%, transparent 68%);
    mask-image: radial-gradient(ellipse at 72% 38%, #000 15%, transparent 68%);
  }
  :global(:root[data-theme='dark']) .hero-dots {
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1.2px, transparent 1.2px);
  }
  .hero-inner {
    position: relative;
    padding-block: 88px 104px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 64px;
  }
  .hero-copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero-copy .lead {
    max-width: 540px;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-promises {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 14px;
    color: var(--lm-muted);
  }
  .hero-promises li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero-promises :global(svg) {
    color: var(--lm-green);
  }
  @media (max-width: 640px) {
    .hero-inner {
      padding-block: 48px 64px;
      gap: 40px;
    }
  }
</style>
