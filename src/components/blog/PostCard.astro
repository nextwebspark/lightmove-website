---
import Icon from '../site/Icon.astro';
import type { IconName } from '../site/Icon.astro';
import { formatDate, readingMinutes, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  compact?: boolean;
}
const { post, compact = false } = Astro.props;

// Each tag gets its own cover so the grid has rhythm without stock imagery.
const covers: Record<
  Post['data']['tag'],
  { icon: IconName; tone: 'wash' | 'warn' | 'panel' | 'plain' }
> = {
  Guides: { icon: 'message', tone: 'wash' },
  Product: { icon: 'transfer', tone: 'warn' },
  Telephony: { icon: 'phone', tone: 'plain' },
  Company: { icon: 'users', tone: 'panel' },
};
const cover = covers[post.data.tag];
---

<a href={`/blog/${post.id}`} class="card card-hover post-card reveal">
  {!compact && (
    <div class:list={['cover', cover.tone]} aria-hidden="true">
      <Icon name={cover.icon} size={64} strokeWidth={1.25} />
    </div>
  )}
  <div class="body">
    <span class="meta">
      <span class="tag">{post.data.tag}</span> · {formatDate(post.data.pubDate)}
    </span>
    <span class="title">{post.data.title}</span>
    {!compact && <span class="muted desc">{post.data.description}</span>}
    {!compact && <span class="meta">{readingMinutes(post.body)} min read</span>}
  </div>
</a>

<style>
  .post-card {
    flex: 1 1 320px;
    padding: 0;
    gap: 0;
    overflow: hidden;
    text-decoration: none;
    color: var(--lm-text);
    border-radius: 20px;
  }
  .post-card:hover {
    color: var(--lm-text);
  }
  .cover {
    height: 168px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lm-green);
    background: var(--lm-wash);
  }
  .cover.warn {
    background: var(--lm-warn-bg);
    color: var(--lm-spark);
  }
  .cover.plain {
    background: var(--lm-surface-2);
  }
  .cover.panel {
    background: var(--lm-panel);
    color: var(--lm-panel-accent);
  }
  .body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
  }
  .meta {
    font-size: 13px;
    color: var(--lm-muted);
  }
  .tag {
    color: var(--lm-brand);
    font-weight: 600;
  }
  .title {
    font-family: var(--lm-font-display);
    font-weight: 600;
    font-size: 21px;
    line-height: 27px;
    letter-spacing: -0.01em;
    color: var(--lm-heading);
  }
  .desc {
    flex-grow: 1;
  }
</style>
