---
import { composeTitle, robotsFor } from '../../lib/seo/meta';
import type { JsonLdNode } from '../../lib/seo/jsonld';
import { absoluteUrl, ogImagePathFor } from '../../lib/seo/url';
import { SITE } from '../../lib/site';
import JsonLd from './JsonLd.astro';

export interface SeoProps {
  title?: string | undefined;
  description: string;
  ogTitle?: string | undefined;
  ogImagePath?: string | undefined;
  ogType?: 'website' | 'article';
  canonical?: string | undefined;
  noindex?: boolean | undefined;
  draft?: boolean | undefined;
  article?:
    | {
        publishedTime: Date;
        modifiedTime?: Date | undefined;
        tags: readonly string[];
      }
    | undefined;
  jsonLd?: readonly JsonLdNode[] | undefined;
}

type Props = SeoProps;

const {
  title,
  description,
  ogTitle,
  ogImagePath,
  ogType = 'website',
  canonical,
  noindex,
  draft,
  article,
  jsonLd = [],
} = Astro.props;

const fullTitle = composeTitle(title);
const canonicalUrl = absoluteUrl(canonical ?? Astro.url.pathname);
const imageUrl = absoluteUrl(ogImagePath ?? ogImagePathFor(Astro.url.pathname));
const imageAlt = ogTitle ?? fullTitle;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robotsFor({ noindex, draft })} />
<meta name="theme-color" content={SITE.themeColor} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle ?? fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    <meta
      property="article:modified_time"
      content={(article.modifiedTime ?? article.publishedTime).toISOString()}
    />
    {article.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle ?? fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<JsonLd nodes={jsonLd} />
