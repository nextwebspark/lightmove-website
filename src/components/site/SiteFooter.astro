---
import { APP, SITE, docsUrl } from '../../lib/site';
import BrandLockup from './BrandLockup.astro';
import Icon from './Icon.astro';
import { TRUST_ITEMS } from '../../lib/trust';
import { consentRequired } from '../../lib/consent';

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#platform', label: 'Platform' },
      { href: '/#use-cases', label: 'Use cases' },
      { href: '/#pricing', label: 'Pricing' },
      { href: APP.url, label: 'Sign in' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: docsUrl(), label: 'Docs' },
      { href: '/blog', label: 'Blog' },
      { href: docsUrl('/go-live/web-widget'), label: 'Web widget' },
      { href: '/blog/rss.xml', label: 'RSS' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/contact', label: 'Contact us' },
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
      { href: '/dpa', label: 'Data Processing Agreement' },
      { href: '/subprocessors', label: 'Sub-processors' },
      { href: '/cookies', label: 'Cookie Policy' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-about">
        <BrandLockup size={30} />
        <p class="muted">
          Voice AI agents for Irish businesses and VoIP operators. A {SITE.company} product, made in{' '}
          {SITE.location}.
        </p>
      </div>
      <div class="footer-cols">
        {columns.map((column) => (
          <nav class="footer-col" aria-label={column.title}>
            <h2>{column.title}</h2>
            {column.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
            {column.title === 'Company' && consentRequired && (
              <button type="button" class="footer-link-button" data-cookie-settings>
                Cookie settings
              </button>
            )}
          </nav>
        ))}
      </div>
    </div>
    <ul class="footer-trust" aria-label="Privacy and security">
      {TRUST_ITEMS.map((item) => (
        <li>
          <a href={item.href}>
            <Icon name={item.icon} size={14} />
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="footer-bottom">
      <span>
        © {year} {SITE.legal.entity}, trading as {SITE.legal.tradingName}. Registered in{' '}
        {SITE.legal.registeredIn}, company number {SITE.legal.companyNumber}. Registered office:{' '}
        {SITE.legal.registeredOffice}.
      </span>
      <a href={`mailto:${SITE.emails.hello}`} class="muted">
        {SITE.emails.hello}
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 20px 0 0;
    list-style: none;
    font-size: 13px;
  }
  .footer-trust a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--lm-muted);
    text-decoration: none;
  }
  .footer-link-button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--lm-text);
    text-align: left;
    cursor: pointer;
  }
  .footer-link-button:hover {
    color: var(--lm-brand);
  }
  .footer-trust a:hover {
    color: var(--lm-text);
  }
</style>
