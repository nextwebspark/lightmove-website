---
// The mark as inline SVG (green tile, voice bars, orange spark). It reads on light and dark.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <rect width="64" height="64" rx="16" fill="#169B62"></rect>
  <rect x="14" y="26" width="6" height="12" rx="3" fill="#FFFFFF"></rect>
  <rect x="24" y="19" width="6" height="26" rx="3" fill="#FFFFFF"></rect>
  <rect x="34" y="13" width="6" height="38" rx="3" fill="#FFFFFF"></rect>
  <rect x="44" y="24" width="6" height="16" rx="3" fill="#FFFFFF"></rect>
  <circle cx="47" cy="16.5" r="3.5" fill="#FF883E"></circle>
</svg>
