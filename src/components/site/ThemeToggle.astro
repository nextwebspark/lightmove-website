---
import Icon from './Icon.astro';
---

<button type="button" class="btn icon-btn theme-toggle" data-theme-toggle aria-label="Switch colour theme">
  <span class="theme-icon-dark"><Icon name="moon" /></span>
  <span class="theme-icon-light"><Icon name="sun" /></span>
</button>

<style>
  .theme-icon-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-icon-light {
    display: inline-flex;
  }
  :global(:root[data-theme='dark']) .theme-icon-dark {
    display: none;
  }
</style>

<script>
  // Same storage key as Starlight's own picker, so the docs and the site stay in step.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const label = () =>
      document.documentElement.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
    button.setAttribute('aria-label', label());
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {
        // Private mode: the choice lasts for this page only.
      }
      button.setAttribute('aria-label', label());
    });
  }
</script>
