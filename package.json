{
  "name": "lightmove-website",
  "version": "0.0.0",
  "private": true,
  "description": "The public website and blog for LightMove.ai at lightmove.ai, and its documentation at docs.lightmove.ai.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:docs": "astro dev --root docs-site --port 4322",
    "build": "npm run build:site && npm run build:docs",
    "build:site": "astro build",
    "build:docs": "astro build --root docs-site",
    "preview": "astro preview",
    "preview:docs": "astro preview --root docs-site --port 4322",
    "check": "astro check && astro check --root docs-site && tsc --noEmit && tsc --noEmit -p docs-site",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:csp": "node scripts/check-csp.ts",
    "check:seo": "node scripts/check-seo.ts",
    "check:functions": "npm --prefix functions ci --no-audit --no-fund && npm --prefix functions run typecheck && npm --prefix functions run build",
    "lhci": "lhci autorun && lhci autorun --config=lighthouserc.docs.json",
    "verify": "npm run lint && npm run format:check && npm run check && npm run test && npm run build && npm run check:csp && npm run check:seo"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.6",
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/sora": "5.2.8",
    "astro": "7.3.8",
    "satori": "0.55.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
