# Embed token of the agent the home page demo talks to. Create it in the LightMove.ai app
# (agent → Deploy → Web widget) with embed mode "headless" and lightmove.ai as an allowed origin.
# Left empty, the demo button explains the demo isn't connected yet.
PUBLIC_DEMO_AGENT_TOKEN=

# Where the platform runs. The widget script and its API both live here.
PUBLIC_APP_URL=https://app.lightmove.ai

# The /contact form is on by default and posts to the contact Cloud Function (functions/README.md),
# which needs its RESEND_API_KEY secret. Set to false to show email links instead of the form.
PUBLIC_CONTACT_FORM_ENABLED=
